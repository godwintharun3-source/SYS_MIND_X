# ==============================================================================
# SYSTEM MIND X — Environment Configuration Template
# ==============================================================================
# WARNING: DO NOT COMMIT REAL SECRETS, API KEYS, OR PASSWORDS TO VERSION CONTROL.
# Copy this file to '.env' for local development:
#   cp .env.example .env
#
# '.env' is strictly excluded from version control in .gitignore.
# ==============================================================================

# Execution Profile: development | testing | staging | production
SYSTEM_MIND_ENV=development

# Network Binding: Bind strictly to loopback by default (127.0.0.1)
SYSTEM_MIND_HOST=127.0.0.1
SYSTEM_MIND_PORT=8765

# Local IPC Domain Socket (Narrow capability broker communications)
SYSTEM_MIND_IPC_SOCKET=/tmp/system_mind.sock

# Logging & Diagnostic Telemetry
# Allowed: DEBUG | INFO | WARNING | ERROR | CRITICAL
SYSTEM_MIND_LOG_LEVEL=INFO

# Secret Storage Provider Backend
# Allowed: mock_memory | env_vars | macos_keychain | windows_credential_manager | linux_secret_service
SYSTEM_MIND_SECRET_BACKEND=mock_memory

# Charter Safety Invariants Enforcement (SC-01 through SC-08)
# Inviolable: Must remain true in all deployment environments.
SYSTEM_MIND_STRICT_INVARIANTS=true

# Storage Root Directory (Audit ledger, digital twin checkpoints, local cache)
SYSTEM_MIND_STORAGE_ROOT=.system_mind

# ------------------------------------------------------------------------------
# Sensitive Credential Placeholders (DO NOT populate in .env.example)
# Real credentials must be injected via OS Keychain or secure local .env
# ------------------------------------------------------------------------------
SYSTEM_MIND_LLM_API_KEY=
SYSTEM_MIND_SIGNING_KEY=
